# .env.local 로 복사해서 쓴다 (git에 올라가지 않음)

# 개발 서버(npm run dev)가 /api 요청을 넘길 서버. 로컬 서버를 쓰려면 http://localhost:8080
VITE_PROXY_TARGET=https://executor-server-production-032d.up.railway.app

# 배포 빌드에서 API 주소 (끝에 /api까지). 비워 두면 같은 출처의 /api 를 부른다
# 예: https://executor-server-production-032d.up.railway.app/api
VITE_API_BASE=
